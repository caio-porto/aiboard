# ==============================================================================
# AI BOARD (aiboard) — Enterprise Multi-Agent Platform (.env.example)
# Copy this file to .env and fill in the values for your environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Platform & Branding Settings
# ------------------------------------------------------------------------------
COMPANY_NAME=AI Board
COMPANY_LEGAL_NAME=AI Board Enterprise Solutions
COMPANY_LOGO_URL=/logo.svg
APP_URL=http://localhost:8000
API_PORT=8001
STREAMLIT_PORT=8501
DEFAULT_LANGUAGE=en
DEFAULT_PARTNER_EMAILS=
SYSTEM_EMAIL=system@ai-board.local

# ------------------------------------------------------------------------------
# 2. Google Gemini & LLM Engine
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# 3. Authentication & Google OAuth 2.0
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000
ALLOWED_GOOGLE_DOMAINS=*
ADMIN_EMAIL=admin@example.com
STREAMLIT_COOKIE_SECRET=change_me_to_a_random_32_char_secret_key

# ------------------------------------------------------------------------------
# 4. Google Workspace Tools (Gmail, Drive, Docs, Sheets)
# ------------------------------------------------------------------------------
# Optional Google Apps Script Web App bridges (if not using direct OAuth tokens)
GOOGLE_APPS_SCRIPT_GMAIL_URL=
GMAIL_APP_KEY=
GOOGLE_APPS_SCRIPT_DRIVE_URL=
DRIVE_APP_KEY=

# Optional Accounting Shared Drive folders
ACCOUNTING_SHARED_DRIVE_ROOT_ID=
ACCOUNTING_DRIVE_FOLDER_2026=

# ------------------------------------------------------------------------------
# 5. Telegram Bot & Executive Approvals
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_ALLOWED_USERS=

# ------------------------------------------------------------------------------
# 6. Notion Workspace Integration
# ------------------------------------------------------------------------------
NOTION_API_KEY=
NOTION_ROOT_PAGE_ID=

# ------------------------------------------------------------------------------
# 7. Marketing & Paid Traffic (Meta Ads & Google Ads)
# ------------------------------------------------------------------------------
META_ADS_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=
META_ADS_APP_ID=
META_ADS_APP_SECRET=
META_ADS_PIXEL_ID=
META_ADS_MCP_URL=http://127.0.0.1:8998/sse

GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_MCP_URL=http://127.0.0.1:8997/sse

# ------------------------------------------------------------------------------
# 8. Omnichannel Customer Support & Automation Microservices
# ------------------------------------------------------------------------------
# Chatwoot (Omnichannel Inbox & PostgreSQL Direct Probe)
CHATWOOT_URL=http://host.docker.internal:3050
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_DB_HOST=chatwoot-postgres
CHATWOOT_DB_PORT=5432
CHATWOOT_DB_USER=postgres
CHATWOOT_DB_PASS=
CHATWOOT_DB_NAME=chatwoot_production

# FreeScout (Helpdesk & MariaDB Direct Probe)
FREESCOUT_URL=http://host.docker.internal:18080
FREESCOUT_API_KEY=
FREESCOUT_DB_HOST=freescout-db
FREESCOUT_DB_PORT=3306
FREESCOUT_DB_USER=freescout
FREESCOUT_DB_PASS=
FREESCOUT_DB_NAME=freescout

# Evolution API (WhatsApp Gateway)
EVOLUTION_API_URL=http://host.docker.internal:8085
EVOLUTION_API_KEY=

# Activepieces (Workflow Automation)
ACTIVEPIECES_URL=http://host.docker.internal:9123
ACTIVEPIECES_API_KEY=

# ------------------------------------------------------------------------------
# 9. Optional Custom / Private Plugins (custom_tools/)
# ------------------------------------------------------------------------------
# ERP & POS Integration
ERP_BASE_URL=
ERP_USER=
ERP_PASS=
ERP_CNPJ=
ERP_DASHBOARD_API_URL=http://host.docker.internal:8502

# Delivery Channels (Entrega Aki, iFood, 99Food)
DELIVERY_STORE_URL=
GESTOR_ENTREGA_AKI_URL=https://gestor.entregaaki.app.br
GESTOR_ENTREGA_AKI_USER=
GESTOR_ENTREGA_AKI_PASS=
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_MERCHANT_ID=
IFOOD_MERCHANT_NAME=
IFOOD_PORTAL_EMAIL=
NINETYNINE_FOOD_APP_ID=
NINETYNINE_FOOD_APP_SECRET=
NINETYNINE_FOOD_STORE_NAME=
NINETYNINE_FOOD_ADMIN_NAME=

# Financial & Open Finance (Conta Azul & Pluggy.ai)
CONTAAZUL_CLIENT_ID=
CONTAAZUL_CLIENT_SECRET=
CONTAAZUL_REDIRECT_URI=http://localhost:8000/api/auth/contaazul/callback
CONTAAZUL_WEB_USER=
CONTAAZUL_WEB_PASS=
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_BANK_NAME=
DRE_DASHBOARD_URL=http://host.docker.internal:3005

# HR & Shopping Mall Portals (MarQ HR & Intranet Mall)
MARQHR_API_TOKEN=
INTRANETMALL_URL=
INTRANETMALL_USER=
INTRANETMALL_PASS=
INTRANETMALL_STORE_NAME=
